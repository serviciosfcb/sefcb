---
// Inner pages and services in English. Paths come from src/i18n/routes.ts.
import InnerPage from '../../components/InnerPage.astro';
import ServicePage from '../../components/ServicePage.astro';
import EducationArticle from '../../components/EducationArticle.astro';
import { getFichas, pathOfFicha, altPathOfFicha } from '../../lib/educacion';
import { getPaginas, getServicios, pathOfPagina, pathOfServicio, toParam } from '../../lib/paginas';
export async function getStaticPaths() {
  const pages = (await getPaginas('en')).map((p) => ({ params: { path: toParam(pathOfPagina(p)) }, props: { kind: 'pagina' as const, p } }));
  const services = (await getServicios('en')).map((s) => ({ params: { path: toParam(pathOfServicio(s)) }, props: { kind: 'servicio' as const, s } }));
  const fichas = await Promise.all((await getFichas('en')).map(async (f) => ({ params: { path: toParam(pathOfFicha(f)) }, props: { kind: 'ficha' as const, f, alt: await altPathOfFicha(f) } })));
  return [...pages, ...services, ...fichas];
}
const props = Astro.props as any;
---
{props.kind === 'pagina' ? <InnerPage p={props.p} lang="en" /> : props.kind === 'ficha' ? <EducationArticle f={props.f} alt={props.alt} lang="en" /> : <ServicePage s={props.s} lang="en" />}

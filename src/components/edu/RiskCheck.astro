---
// Lista de factores de riesgo para marcar. Cuenta lo que la persona marca; no guarda ni envía nada.
import type { Lang } from '../../i18n/content';
import Icon from '../Icon.astro';
interface Props { lang: Lang; titulo?: string; items: string[] }
const { lang, titulo, items } = Astro.props;
const en = lang === 'en';
const t = en
  ? { title: 'Check your risk', hint: titulo || 'Tick what applies to you', of: 'of', marked: 'ticked', none: 'You have not ticked anything yet. High blood pressure usually has no symptoms, so have it checked at least once a year. Age also raises your risk.', some: 'The more boxes you tick, the higher your risk of high blood pressure and of heart and artery disease. Age also raises your risk. Check your blood pressure regularly and talk to your doctor.', note: 'Nothing you tick is saved or sent.' }
  : { title: 'Revise su riesgo', hint: titulo || 'Marque lo que aplica para usted', of: 'de', marked: 'marcados', none: 'No ha marcado nada todavía. La presión alta casi nunca da síntomas, así que mídasela al menos una vez al año. La edad también aumenta el riesgo.', some: 'Mientras más casillas marque, mayor es su riesgo de tener presión alta y enfermedades del corazón y las arterias. La edad también aumenta el riesgo. Mídase la presión con regularidad y hable con su médico.', note: 'Lo que marque no se guarda ni se envía.' };
---
<section class="edr" aria-labelledby="edr-t" data-edr data-t={JSON.stringify(t)} data-total={items.length}>
  <div class="edr-cab">
    <span class="edr-ico" aria-hidden="true"><Icon name="target" /></span>
    <h2 id="edr-t">{t.title}</h2>
  </div>
  <fieldset class="edr-campo">
    <legend>{t.hint}</legend>
    <ul class="edr-lista">
      {items.map((x, i) => (
        <li><input type="checkbox" id={`edr-${i}`} data-edr-item /><label for={`edr-${i}`}>{x}</label></li>
      ))}
    </ul>
  </fieldset>
  <div class="edr-res">
    <div class="edr-medidor" aria-hidden="true">{items.map(() => <i></i>)}</div>
    <p aria-live="polite" data-edr-res><strong>0 {t.of} {items.length}</strong> {t.marked}. {t.none}</p>
  </div>
  <p class="edr-nota">{t.note}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-edr]').forEach((box) => {
    const t = JSON.parse(box.dataset.t || '{}');
    const total = Number(box.dataset.total);
    const items = [...box.querySelectorAll<HTMLInputElement>('[data-edr-item]')];
    const res = box.querySelector<HTMLElement>('[data-edr-res]')!;
    const marcas = [...box.querySelectorAll<HTMLElement>('.edr-medidor i')];
    const update = () => {
      const n = items.filter((i) => i.checked).length;
      marcas.forEach((m, i) => m.classList.toggle('on', i < n));
      box.style.setProperty('--nivel', String(n / total));
      const b = document.createElement('strong'); b.textContent = `${n} ${t.of} ${total}`;
      res.replaceChildren(b, ` ${t.marked}. ${n ? t.some : t.none}`);
    };
    items.forEach((i) => i.addEventListener('change', update));
  });
</script>

<style>
  .edr { display: grid; gap: 1.1rem; padding: clamp(1.3rem, 3vw, 2rem); border-radius: var(--radio-l); background: var(--niebla); }
  .edr-cab { display: flex; align-items: center; gap: .8rem; }
  .edr-cab h2 { font-size: var(--t-4); }
  .edr-ico { width: 2.8rem; height: 2.8rem; border-radius: 50%; display: grid; place-items: center; background: var(--papel); color: var(--rojo); flex: none; }
  .edr-ico :global(.icon) { width: 1.4rem; height: 1.4rem; }
  .edr-campo { border: 0; padding: 0; margin: 0; min-width: 0; }
  .edr-campo legend { font-weight: 700; padding: 0; margin-bottom: .8rem; }
  .edr-lista { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: .5rem; }
  .edr-lista li { position: relative; }
  .edr-lista input { position: absolute; left: .9rem; top: .95rem; width: 1.25rem; height: 1.25rem; accent-color: var(--rojo); margin: 0; }
  .edr-lista label { display: block; height: 100%; padding: .75rem .9rem .75rem 2.8rem; border-radius: var(--radio-m); background: var(--papel); border: 1px solid var(--linea); line-height: 1.4; cursor: pointer; transition: border-color .3s, background-color .3s; }
  .edr-lista input:checked + label { border-color: var(--rojo); background: var(--rojo-tinte); }
  .edr-lista input:focus-visible + label { outline: 3px solid var(--rojo); outline-offset: 2px; }
  .edr-res { display: grid; gap: .7rem; padding: 1rem 1.1rem; border-radius: var(--radio-m); background: var(--papel); }
  .edr-medidor { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; }
  .edr-medidor i { height: 10px; border-radius: 3px; background: var(--linea); transition: background-color .3s; }
  .edr-medidor i.on { background: color-mix(in srgb, var(--rojo) calc(40% + var(--nivel, 0) * 60%), #e2b45c); }
  .edr-res p { line-height: 1.5; }
  .edr-nota { font-size: var(--t-0); color: var(--tinta-2); }
</style>

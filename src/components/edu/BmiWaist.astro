---
// Calculadora de índice de masa corporal y cintura, con los valores del Ministerio de Salud.
// Calcula en el navegador; no guarda ni envía nada.
import type { Lang } from '../../i18n/content';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const t = en
  ? {
      title: 'Your BMI and waist', lead: 'Type your numbers. Nothing is saved or sent.',
      weight: 'Weight', height: 'Height', waist: 'Waist (optional)', sex: 'Sex', woman: 'Woman', man: 'Man', kg: 'kg', cm: 'cm',
      waistHint: 'Measure around your belly, at the level of the navel, after breathing out.',
      idle: 'Enter your weight and height to see your BMI.', bmi: 'Your BMI is',
      cats: ['underweight', 'healthy weight', 'overweight', 'obesity'],
      waistOk: 'Your waist is within the healthy range.', waistHigh: 'Your waist shows abdominal obesity, which raises heart risk.',
      scale: ['Under 18.5', '18.5–24.9', '25–29.9', '30 or more'], note: 'Does not apply to pregnant women, children or teenagers.',
      scaleLabel: 'BMI scale',
    }
  : {
      title: 'Su IMC y su cintura', lead: 'Escriba sus datos. No se guarda ni se envía nada.',
      weight: 'Peso', height: 'Estatura', waist: 'Cintura (opcional)', sex: 'Sexo', woman: 'Mujer', man: 'Hombre', kg: 'kg', cm: 'cm',
      waistHint: 'Mídala alrededor del abdomen, a la altura del ombligo, después de soltar el aire.',
      idle: 'Escriba su peso y su estatura para ver su IMC.', bmi: 'Su IMC es',
      cats: ['bajo peso', 'peso saludable', 'sobrepeso', 'obesidad'],
      waistOk: 'Su cintura está dentro del valor saludable.', waistHigh: 'Su cintura indica obesidad abdominal, que aumenta el riesgo del corazón.',
      scale: ['Menos de 18,5', '18,5 a 24,9', '25 a 29,9', '30 o más'], note: 'No aplica a mujeres embarazadas, niños ni adolescentes.',
      scaleLabel: 'Escala del IMC',
    };
---
<section class="edi" aria-labelledby="edi-t" data-edi data-lang={lang} data-t={JSON.stringify(t)}>
  <div class="edi-cab">
    <span class="edi-ico" aria-hidden="true"><Icon name="ruler" /></span>
    <div><h2 id="edi-t">{t.title}</h2><p>{t.lead}</p></div>
  </div>
  <div class="edi-form">
    <div class="edi-campo"><label for="edi-peso">{t.weight}</label><div class="edi-in"><input id="edi-peso" type="number" inputmode="decimal" min="20" max="300" step="0.1" data-edi-peso /><span>{t.kg}</span></div></div>
    <div class="edi-campo"><label for="edi-talla">{t.height}</label><div class="edi-in"><input id="edi-talla" type="number" inputmode="numeric" min="100" max="230" data-edi-talla /><span>{t.cm}</span></div></div>
    <div class="edi-campo"><label for="edi-cintura">{t.waist}</label><div class="edi-in"><input id="edi-cintura" type="number" inputmode="numeric" min="40" max="200" aria-describedby="edi-ch" data-edi-cintura /><span>{t.cm}</span></div></div>
    <fieldset class="edi-sexo">
      <legend>{t.sex}</legend>
      <label><input type="radio" name="edi-sexo" value="m" checked data-edi-sexo />{t.woman}</label>
      <label><input type="radio" name="edi-sexo" value="h" data-edi-sexo />{t.man}</label>
    </fieldset>
  </div>
  <p id="edi-ch" class="edi-ayuda">{t.waistHint}</p>

  <div class="edi-res" aria-live="polite" data-edi-res><p>{t.idle}</p></div>
  <div class="edi-escala" role="img" aria-label={`${t.scaleLabel}: ${t.cats.map((c, i) => `${t.scale[i]} ${c}`).join(', ')}`}>
    <div class="edi-barra" aria-hidden="true">
      {t.cats.map((c, i) => <span class={`edi-seg s${i}`}><b>{c}</b><small>{t.scale[i]}</small></span>)}
      <i class="edi-marca" data-edi-marca hidden></i>
    </div>
  </div>
  <p class="edi-nota">{t.note}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-edi]').forEach((box) => {
    const t = JSON.parse(box.dataset.t || '{}');
    const loc = box.dataset.lang === 'en' ? 'en-US' : 'es-CO';
    const $ = <T extends Element>(s: string) => box.querySelector<T>(s)!;
    const peso = $<HTMLInputElement>('[data-edi-peso]'), talla = $<HTMLInputElement>('[data-edi-talla]'), cintura = $<HTMLInputElement>('[data-edi-cintura]');
    const res = $<HTMLElement>('[data-edi-res]'), marca = $<HTMLElement>('[data-edi-marca]');
    const sexos = [...box.querySelectorAll<HTMLInputElement>('[data-edi-sexo]')];
    const calc = () => {
      const p = parseFloat(peso.value.replace(',', '.')), h = parseFloat(talla.value) / 100, c = parseFloat(cintura.value);
      const partes: HTMLElement[] = [];
      if (p > 0 && h > 0.9) {
        const imc = p / (h * h);
        const cat = imc < 18.5 ? 0 : imc < 25 ? 1 : imc < 30 ? 2 : 3;
        const el = document.createElement('p');
        el.className = `edi-imc c${cat}`;
        el.innerHTML = `${t.bmi} <strong></strong> · <span></span>`;
        el.querySelector('strong')!.textContent = imc.toLocaleString(loc, { maximumFractionDigits: 1, minimumFractionDigits: 1 });
        el.querySelector('span')!.textContent = t.cats[cat];
        partes.push(el);
        // Marca en la barra: cuatro tramos iguales (15–18,5 · 18,5–25 · 25–30 · 30–40)
        const tramos = [15, 18.5, 25, 30, 40];
        const dentro = Math.min(1, Math.max(0, (imc - tramos[cat]) / (tramos[cat + 1] - tramos[cat])));
        const pos = (cat + dentro) * 25;
        marca.hidden = false; marca.style.left = `${pos}%`;
      } else marca.hidden = true;
      if (c > 0) {
        const mujer = sexos.find((s) => s.checked)?.value !== 'h';
        const alta = mujer ? c > 80 : c > 90;
        const el = document.createElement('p');
        el.className = `edi-cint${alta ? ' alta' : ''}`;
        el.textContent = alta ? t.waistHigh : t.waistOk;
        partes.push(el);
      }
      if (!partes.length) { const el = document.createElement('p'); el.textContent = t.idle; partes.push(el); }
      res.replaceChildren(...partes);
    };
    [peso, talla, cintura, ...sexos].forEach((i) => i.addEventListener('input', calc));
  });
</script>

<style>
  .edi { display: grid; gap: 1.1rem; padding: clamp(1.3rem, 3vw, 2rem); border-radius: var(--radio-l); background: var(--niebla); }
  .edi-cab { display: flex; gap: .9rem; align-items: flex-start; }
  .edi-cab h2 { font-size: var(--t-4); }
  .edi-cab p { color: var(--tinta-2); font-size: var(--t-0); margin-top: .2rem; }
  .edi-ico { width: 2.8rem; height: 2.8rem; border-radius: 50%; display: grid; place-items: center; background: var(--papel); color: var(--rojo); flex: none; }
  .edi-ico :global(.icon) { width: 1.4rem; height: 1.4rem; }
  .edi-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: .9rem; align-items: end; }
  .edi-campo { display: grid; gap: .3rem; }
  .edi-campo label, .edi-sexo legend { font-weight: 700; font-size: var(--t-0); }
  .edi-in { display: flex; align-items: center; border-radius: var(--radio-s); border: 1px solid #b9b7b2; background: var(--papel); overflow: hidden; }
  .edi-in:focus-within { outline: 3px solid var(--rojo); outline-offset: 1px; }
  .edi-in input { flex: 1; min-width: 0; min-height: 3rem; padding: .5rem .8rem; border: 0; background: transparent; font: inherit; font-size: 1.1rem; outline: none; }
  .edi-in span { padding: 0 .8rem; color: var(--tinta-2); font-size: var(--t-0); }
  .edi-sexo { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem .9rem; align-items: center; min-width: 0; }
  .edi-sexo legend { width: 100%; padding: 0; margin-bottom: .3rem; }
  .edi-sexo label { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.6rem; cursor: pointer; }
  .edi-sexo input { width: 1.2rem; height: 1.2rem; accent-color: var(--rojo); }
  .edi-ayuda, .edi-nota { font-size: var(--t-0); color: var(--tinta-2); }
  .edi-res { display: grid; gap: .5rem; }
  .edi-res p { padding: .85rem 1.1rem; border-radius: var(--radio-m); background: var(--papel); line-height: 1.45; }
  .edi-res :global(.edi-imc) { font-size: var(--t-2); }
  .edi-res :global(.edi-imc strong) { font-family: var(--display); font-size: 1.6em; letter-spacing: -.02em; }
  .edi-res :global(.edi-imc.c1) { box-shadow: inset 4px 0 0 #2f7d4f; }
  .edi-res :global(.edi-imc.c2), .edi-res :global(.edi-imc.c0) { box-shadow: inset 4px 0 0 #b7791f; }
  .edi-res :global(.edi-imc.c3), .edi-res :global(.edi-cint.alta) { box-shadow: inset 4px 0 0 var(--rojo); }
  .edi-barra { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3px; padding-top: .9rem; }
  .edi-seg { display: grid; gap: .25rem; padding-top: .6rem; border-top: 8px solid; font-size: .8rem; line-height: 1.2; min-width: 0; }
  .edi-seg b { font-weight: 700; }
  .edi-seg small { color: var(--tinta-2); font-size: .76rem; }
  .s0 { border-color: #e2b45c; } .s1 { border-color: #3f9a62; } .s2 { border-color: #e2b45c; } .s3 { border-color: var(--rojo); }
  .edi-marca { position: absolute; top: 0; width: 0; height: 0; margin-left: -8px; border: 8px solid transparent; border-top-color: var(--tinta); transition: left .5s var(--ease); }
  .edi-marca[hidden] { display: none; }
  @media (max-width: 520px) { .edi-seg b { font-size: .72rem; } .edi-seg small { font-size: .68rem; } }
</style>

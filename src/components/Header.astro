---
import type { Lang } from '../i18n/content';
import { content, links, phones } from '../i18n/content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang; home: string; alt: string }
const { lang, home, alt } = Astro.props;
const t = content[lang];
const altLang = lang === 'es' ? 'en' : 'es';
---
<header class="cabecera" data-header>
  <div class="util">
    <div class="contenedor util-in">
      <a class="util-tel" href={`tel:${phones.atencion1.tel}`}><Icon name="phone" /><span>{t.util.line}</span> <strong>{phones.atencion1.label}</strong></a>
      <ul class="util-links">
        <li><a href={links.pqrs} rel="noopener">{t.util.pqrs}</a></li>
        <li><a href={links.pagos} rel="noopener">{t.util.pay}</a></li>
        <li><a href={links.empleo}>{t.util.jobs}</a></li>
        <li><button type="button" data-a11y-open><Icon name="access" />{t.util.a11y}</button></li>
      </ul>
    </div>
  </div>

  <div class="barra">
    <div class="contenedor barra-in">
      <Logo lang={lang} href={home} variant="auto" />

      <nav class="nav" aria-label={t.nav.label}>
        <ul>
          {t.nav.items.map((item) => (
            <li><a href={item.href} data-nav-link>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="acciones">
        <a class="idioma" href={alt} hreflang={altLang} lang={altLang} title={t.util.switchHint}>
          <Icon name="globe" /><span>{altLang.toUpperCase()}</span><span class="visualmente-oculto">, {t.util.switchLabel}</span>
        </a>
        <a class="btn btn-pequeno btn-fantasma resultados" href={links.portal} rel="noopener">{t.nav.results}</a>
        <a class="btn btn-pequeno btn-primario cita" href={links.portal} rel="noopener" data-magnet>{t.nav.book}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-btn>
          <span class="menu-lineas" aria-hidden="true"><span></span><span></span></span>
          <span class="visualmente-oculto" data-menu-label>{t.nav.menu}</span>
        </button>
      </div>
    </div>
  </div>

  <div id="menu-movil" class="menu-movil" data-menu hidden>
    <div class="contenedor menu-in">
      <nav aria-label={t.nav.label}>
        <ul class="menu-lista">
          {t.nav.items.map((item, i) => (
            <li style={`--i:${i}`}><a href={item.href} data-menu-link>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="menu-pie">
        <a class="btn btn-primario" href={links.portal} rel="noopener">{t.nav.book}</a>
        <a class="btn btn-fantasma" href={links.portal} rel="noopener">{t.nav.results}</a>
        <a class="menu-tel" href={`tel:${phones.atencion1.tel}`}>{t.util.line} <strong>{phones.atencion1.label}</strong></a>
        <div class="menu-util">
          <a href={links.pqrs} rel="noopener">{t.util.pqrs}</a>
          <a href={links.pagos} rel="noopener">{t.util.pay}</a>
          <button type="button" data-a11y-open>{t.util.a11y}</button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const texts = { open: label.textContent, close: document.documentElement.lang === 'en' ? 'Close menu' : 'Cerrar menú' };

  // Cabecera transparente sobre el héroe; sólida y compacta al bajar
  let last = -1;
  const onScroll = () => {
    const y = window.scrollY;
    const solid = y > 24;
    if (solid !== header.classList.contains('solida')) header.classList.toggle('solida', solid);
    header.classList.toggle('oculta', y > 600 && y > last + 4 && !header.classList.contains('abierta'));
    if (y < last - 4) header.classList.remove('oculta');
    last = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? texts.close : texts.open;
    header.classList.toggle('abierta', open);
    document.documentElement.classList.toggle('sin-scroll', open);
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('visible'));
      menu.querySelector<HTMLAnchorElement>('a')?.focus();
    } else {
      menu.classList.remove('visible');
      setTimeout(() => { if (!header.classList.contains('abierta')) menu.hidden = true; }, 450);
    }
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  menu.querySelectorAll('[data-a11y-open]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('abierta')) { setOpen(false); btn.focus(); }
  });
  // Mantener el foco dentro del menú abierto
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = [...menu.querySelectorAll<HTMLElement>('a, button')].concat(btn);
    const first = f[0], lastEl = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); lastEl.focus(); }
    else if (!e.shiftKey && document.activeElement === lastEl) { e.preventDefault(); first.focus(); }
  });
  matchMedia('(min-width: 1081px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });

  // Sección activa en el menú
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const targets = navLinks.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => {
      if (!en.isIntersecting) return;
      navLinks.forEach((a) => a.toggleAttribute('aria-current', a.getAttribute('href') === `#${en.target.id}`));
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  targets.forEach((t) => io.observe(t));
</script>

<style>
  .cabecera {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--sobre-oscuro);
    transition: transform .6s var(--ease), color .4s var(--ease);
  }
  .cabecera::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgb(255 255 255 / .9); backdrop-filter: saturate(1.6) blur(18px); -webkit-backdrop-filter: saturate(1.6) blur(18px);
    box-shadow: 0 1px 0 var(--linea), 0 18px 40px -28px rgb(var(--sombra) / .35);
    opacity: 0; transition: opacity .45s var(--ease);
  }
  .cabecera.solida { color: var(--tinta); }
  .cabecera.solida::before { opacity: 1; }
  .cabecera.oculta { transform: translateY(-100%); }
  :global(.sin-scroll) { overflow: hidden; }

  .util { overflow: hidden; max-height: 2.6rem; transition: max-height .5s var(--ease), opacity .4s var(--ease); border-bottom: 1px solid rgb(255 255 255 / .1); }
  .cabecera.solida .util { max-height: 0; opacity: 0; border-color: transparent; }
  .util-in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 2.6rem; font-size: var(--t-0); }
  .util a, .util button { color: var(--sobre-oscuro-2); text-decoration: none; background: none; border: 0; cursor: pointer; padding: .3rem 0; display: inline-flex; align-items: center; gap: .4rem; transition: color .25s; }
  .util a:hover, .util button:hover { color: #fff; }
  .util-tel strong { color: #fff; font-weight: 700; letter-spacing: .01em; }
  .util .icon { width: 1rem; height: 1rem; }
  .util-links { list-style: none; display: flex; gap: 1.6rem; }

  .barra-in { display: flex; align-items: center; gap: 2rem; min-height: var(--alto-cabecera); }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; display: flex; gap: .25rem; }
  .nav a {
    position: relative; display: block; padding: .55rem .8rem; border-radius: 999px;
    color: inherit; text-decoration: none; font-weight: 600; font-size: .95rem; opacity: .86; transition: opacity .25s, background-color .25s;
  }
  .nav a::after { content: ''; position: absolute; left: .8rem; right: .8rem; bottom: .25rem; height: 2px; border-radius: 2px; background: var(--rojo-luz); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease); }
  .cabecera.solida .nav a::after { background: var(--rojo); }
  .nav a:hover, .nav a[aria-current] { opacity: 1; }
  .nav a:hover::after, .nav a[aria-current]::after { transform: scaleX(1); }

  .acciones { display: flex; align-items: center; gap: .6rem; }
  .idioma { display: inline-flex; align-items: center; gap: .35rem; padding: .5rem .55rem; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: var(--t-0); color: inherit; opacity: .9; }
  .idioma:hover { opacity: 1; background: rgb(127 127 127 / .12); }
  .idioma .icon { width: 1.1rem; height: 1.1rem; }
  .cabecera.solida .btn-fantasma { --fg: var(--tinta); --bd: var(--linea); --bg: transparent; backdrop-filter: none; }
  .cabecera.solida .btn-fantasma:hover { --bd: var(--tinta); }

  .menu-btn { display: none; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid rgb(127 127 127 / .35); background: transparent; cursor: pointer; place-items: center; }
  .menu-lineas { display: grid; gap: 6px; width: 20px; }
  .menu-lineas span { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform .45s var(--ease); }
  .abierta .menu-lineas span:first-child { transform: translateY(4px) rotate(45deg); }
  .abierta .menu-lineas span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .menu-movil {
    position: fixed; inset: 0; z-index: -2; background: var(--carbon); color: var(--sobre-oscuro);
    padding-top: calc(var(--alto-cabecera) + env(safe-area-inset-top, 0px) + 1rem); padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    overflow-y: auto; clip-path: circle(0% at calc(100% - 40px) 40px); transition: clip-path .6s var(--ease-io);
  }
  .menu-movil.visible { clip-path: circle(150% at calc(100% - 40px) 40px); }
  .abierta { color: var(--sobre-oscuro) !important; }
  .abierta::before { opacity: 0 !important; }
  .abierta :global(.logo-auto .logo-c) { opacity: 0 !important; }
  .abierta :global(.logo-auto .logo-b) { opacity: 1 !important; }
  .menu-in { display: grid; gap: 2.5rem; }
  .menu-lista { list-style: none; display: grid; gap: .2rem; }
  .menu-lista a { display: block; padding: .5rem 0; font-family: var(--display); font-size: clamp(2rem, 8vw, 3rem); font-weight: 600; letter-spacing: -.03em; text-decoration: none; color: inherit; }
  .menu-lista li { opacity: 0; transform: translateY(24px); transition: opacity .5s var(--ease), transform .7s var(--ease); transition-delay: calc(.12s + var(--i) * .06s); }
  .menu-movil.visible .menu-lista li { opacity: 1; transform: none; }
  .menu-pie { display: grid; gap: .8rem; max-width: 26rem; }
  .menu-tel { color: var(--sobre-oscuro-2); text-decoration: none; margin-top: .6rem; }
  .menu-tel strong { color: #fff; }
  .menu-util { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: .4rem; }
  .menu-util a, .menu-util button { color: var(--sobre-oscuro-2); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: .25em; }

  @media (max-width: 1080px) {
    .nav, .util, .resultados { display: none; }
    .menu-btn { display: grid; }
    .acciones { margin-left: auto; }
  }
  @media (max-width: 520px) {
    .cita { display: none; }
    .barra-in { gap: .75rem; }
  }
  :global(:root[data-contrast='high']) .cabecera::before { background: #fff; backdrop-filter: none; }
</style>

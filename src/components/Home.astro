---
import type { Lang } from '../i18n/content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import QuickActions from './QuickActions.astro';
import Services from './Services.astro';
import Gallery from './Gallery.astro';
import Visit from './Visit.astro';
import Portal from './Portal.astro';
import LatestNews from './LatestNews.astro';
import Insurers from './Insurers.astro';
import Trust from './Trust.astro';
import Locations from './Locations.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Hero lang={lang} />
  <QuickActions lang={lang} />
  <Services lang={lang} />
  <Gallery lang={lang} />
  <Visit lang={lang} />
  <Portal lang={lang} />
  <LatestNews lang={lang} />
  <Insurers lang={lang} />
  <Trust lang={lang} />
  <Locations lang={lang} />
</Base>

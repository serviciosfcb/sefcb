---
import type { Lang } from '../i18n/content';
import { content, links } from '../i18n/content';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].a11y;
const wa = content[lang].whatsapp;
const toggles = [
  { key: 'contrast', on: 'high', label: t.contrast },
  { key: 'links', on: 'underline', label: t.links },
  { key: 'spacing', on: 'wide', label: t.spacing },
  { key: 'motion', on: 'reduced', label: t.motion },
];
---
<button class="flotante a11y-flotante" type="button" data-a11y-open aria-haspopup="dialog">
  <Icon name="access" /><span class="flotante-txt">{t.title}</span>
</button>

<a class="flotante wa-flotante" href={links.whatsapp} rel="noopener">
  <Icon name="whatsapp" /><span class="visualmente-oculto">{wa}</span>
</a>

<dialog class="a11y" data-a11y aria-labelledby="a11y-titulo">
  <form method="dialog" class="a11y-in">
    <div class="a11y-cab">
      <span class="a11y-sello" aria-hidden="true"><Icon name="access" /></span>
      <h2 id="a11y-titulo">{t.title}</h2>
      <button class="cerrar" value="close" aria-label={t.close}><Icon name="close" /></button>
    </div>
    <p class="intro">{t.intro}</p>

    <fieldset class="grupo">
      <legend>{t.text}</legend>
      <div class="segmentos">
        {t.textOpts.map((opt, i) => (
          <label class="seg">
            <input type="radio" name="a11y-text" id={`a11y-text-${i + 1}`} value={String(i + 1)} checked={i === 0} />
            <span style={`font-size:${1 + i * 0.16}rem`}>{opt}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <ul class="interruptores">
      {toggles.map((tg) => (
        <li>
          <label class="switch" for={`a11y-${tg.key}`}>
            <span>{tg.label}</span>
            <input type="checkbox" role="switch" id={`a11y-${tg.key}`} data-key={tg.key} value={tg.on} />
            <span class="pista" aria-hidden="true"></span>
          </label>
        </li>
      ))}
    </ul>

    <button type="button" class="btn btn-borde escuchar" data-listen data-listen-label={t.listen} data-stop-label={t.stop}>
      <Icon name="speaker" /><span data-listen-text>{t.listen}</span>
    </button>

    <div class="relevo">
      <p>{t.relay}</p>
      <a class="enlace-flecha" href={links.relevo} rel="noopener">{t.relayLink}<Icon name="external" /></a>
    </div>

    <div class="a11y-pie">
      <button type="button" class="btn btn-borde btn-pequeno" data-a11y-reset>{t.reset}</button>
      <button class="btn btn-primario btn-pequeno" value="close">{t.close}</button>
    </div>
  </form>
</dialog>

<script>
  type Key = 'text' | 'contrast' | 'links' | 'spacing' | 'motion';
  type Prefs = Partial<Record<Key, string>>;
  const KEY = 'sefcb-a11y';
  const root = document.documentElement;
  const dialog = document.querySelector<HTMLDialogElement>('[data-a11y]')!;
  const read = (): Prefs => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
  const save = (p: Prefs) => { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch { /* sin almacenamiento disponible */ } };
  const apply = (p: Prefs) => {
    for (const k of ['text', 'contrast', 'links', 'spacing', 'motion'] as Key[]) {
      if (p[k] && !(k === 'text' && p[k] === '1')) root.dataset[k] = p[k]!; else delete root.dataset[k];
    }
    document.dispatchEvent(new CustomEvent('a11y:change'));
  };
  const sync = (p: Prefs) => {
    dialog.querySelectorAll<HTMLInputElement>('input[name="a11y-text"]').forEach((r) => { r.checked = r.value === (p.text || '1'); });
    dialog.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((c) => { c.checked = p[c.dataset.key as Key] === c.value; });
  };
  let prefs = read();
  sync(prefs);

  document.querySelectorAll('[data-a11y-open]').forEach((b) => b.addEventListener('click', () => { sync(prefs); dialog.showModal(); }));
  dialog.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'a11y-text') prefs.text = el.value;
    else if (el.dataset.key) prefs[el.dataset.key as Key] = el.checked ? el.value : '';
    save(prefs); apply(prefs);
  });
  dialog.querySelector('[data-a11y-reset]')?.addEventListener('click', () => { prefs = {}; save(prefs); apply(prefs); sync(prefs); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  // Los botones flotantes aparecen al dejar atrás el héroe, que ya tiene sus propios accesos
  const floats = document.querySelectorAll<HTMLElement>('.flotante');
  const showFloats = () => { const on = window.scrollY > window.innerHeight * .55; floats.forEach((f) => f.classList.toggle('visible', on)); };
  addEventListener('scroll', showFloats, { passive: true });
  showFloats();

  // Lectura en voz alta del contenido principal
  const listen = dialog.querySelector<HTMLButtonElement>('[data-listen]')!;
  const listenText = listen.querySelector<HTMLElement>('[data-listen-text]')!;
  const synth = 'speechSynthesis' in window ? window.speechSynthesis : null;
  if (!synth) listen.hidden = true;
  const setReading = (on: boolean) => { listenText.textContent = on ? listen.dataset.stopLabel! : listen.dataset.listenLabel!; listen.classList.toggle('leyendo', on); };
  listen.addEventListener('click', () => {
    if (!synth) return;
    if (synth.speaking) { synth.cancel(); setReading(false); return; }
    const main = document.querySelector('main');
    const text = (main?.innerText || '').replace(/\s+\n/g, '\n').slice(0, 12000);
    const u = new SpeechSynthesisUtterance(text);
    u.lang = root.lang === 'en' ? 'en-US' : 'es-CO';
    u.rate = .95;
    u.onend = u.onerror = () => setReading(false);
    synth.speak(u); setReading(true);
  });
</script>

<style>
  .flotante {
    position: fixed; z-index: 45; bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    height: 3.5rem; border-radius: 999px; display: inline-flex; align-items: center; gap: .55rem;
    cursor: pointer; border: 0; text-decoration: none;
    box-shadow: 0 18px 40px -16px rgb(var(--sombra) / .7);
    transition: transform .6s var(--ease), box-shadow .5s var(--ease), opacity .4s var(--ease), visibility 0s linear .6s;
    transform: translateY(160%); opacity: 0; visibility: hidden;
  }
  .flotante.visible { transform: none; opacity: 1; visibility: visible; transition: transform .6s var(--ease), box-shadow .5s var(--ease), opacity .4s var(--ease), visibility 0s; }
  .flotante.visible:hover { transform: translateY(-3px) scale(1.03); }
  .flotante :global(.icon) { width: 1.6rem; height: 1.6rem; }
  .a11y-flotante { left: calc(18px + env(safe-area-inset-left, 0px)); padding: 0 .95rem; background: var(--tinta); color: #fff; outline: 2px solid rgb(255 255 255 / .9); outline-offset: -4px; gap: 0; }
  .a11y-flotante .flotante-txt { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .5s var(--ease), margin .5s var(--ease); }
  .a11y-flotante:hover .flotante-txt, .a11y-flotante:focus-visible .flotante-txt { max-width: 10rem; margin-left: .55rem; }
  .a11y-flotante:focus-visible { outline: 3px solid var(--foco); outline-offset: 3px; }
  .flotante-txt { font-weight: 700; font-size: var(--t-0); }
  .wa-flotante { right: calc(18px + env(safe-area-inset-right, 0px)); width: 3.5rem; justify-content: center; background: #1f8f4e; color: #fff; }
  .wa-flotante::before { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 2px solid #1f8f4e; animation: wa-pulso 2.8s var(--ease) infinite; }
  @keyframes wa-pulso { 0% { transform: scale(1); opacity: .8; } 100% { transform: scale(1.5); opacity: 0; } }
  @media (hover: none) { .flotante-txt { display: none; } .a11y-flotante { width: 3.5rem; padding: 0; justify-content: center; } }

  .a11y {
    width: min(31rem, calc(100vw - 32px)); max-height: calc(100dvh - 32px); margin: auto; overflow-y: auto; overscroll-behavior: contain;
    padding: 0; border: 0; border-radius: var(--radio-l);
    background: var(--papel); color: var(--tinta);
    box-shadow: 0 50px 100px -40px rgb(var(--sombra) / .8);
  }
  .a11y::backdrop { background: rgb(28 26 25 / .55); backdrop-filter: blur(4px); }
  .a11y[open] { animation: panel-in .45s var(--ease); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: none; } }
  .a11y-in { display: grid; gap: 1.2rem; padding: 1.6rem; }
  .a11y-cab { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; }
  .a11y-sello { width: 2.8rem; height: 2.8rem; border-radius: 50%; display: grid; place-items: center; background: var(--tinta); color: #fff; }
  .a11y-cab h2 { font-size: var(--t-4); }
  .cerrar { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--linea); background: var(--papel); color: var(--tinta); display: grid; place-items: center; cursor: pointer; }
  .intro { color: var(--tinta-2); font-size: var(--t-0); }
  .grupo { border: 0; padding: 0; margin: 0; }
  .grupo legend { font-weight: 700; margin-bottom: .6rem; padding: 0; }
  .segmentos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .seg { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span { display: grid; place-items: center; min-height: 3.2rem; padding: .25rem; border-radius: var(--radio-s); border: 2px solid var(--linea); font-weight: 700; text-align: center; line-height: 1.1; transition: border-color .25s, background-color .25s, color .25s; }
  .seg input:checked + span { border-color: var(--rojo); background: var(--rojo-tinte); color: var(--rojo); }
  .seg input:focus-visible + span { outline: 3px solid var(--foco); outline-offset: 2px; }
  .interruptores { list-style: none; display: grid; }
  .switch { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.4rem; border-top: 1px solid var(--linea); cursor: pointer; font-weight: 600; position: relative; }
  .switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pista { flex: none; width: 3.1rem; height: 1.8rem; border-radius: 999px; background: var(--linea); position: relative; transition: background-color .25s var(--ease); }
  .pista::after { content: ''; position: absolute; top: .2rem; left: .2rem; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / .3); transition: transform .3s var(--ease); }
  .switch input:checked + .pista { background: var(--rojo); }
  .switch input:checked + .pista::after { transform: translateX(1.3rem); }
  .switch input:focus-visible + .pista { outline: 3px solid var(--foco); outline-offset: 3px; }
  .escuchar { justify-content: flex-start; }
  .escuchar.leyendo { --bd: var(--rojo); --fg: var(--rojo); }
  .relevo { display: grid; gap: .5rem; font-size: var(--t-0); color: var(--tinta-2); background: var(--niebla); padding: 1rem 1.1rem; border-radius: var(--radio-s); }
  .a11y-pie { display: flex; justify-content: space-between; gap: .75rem; }
  :global(:root[data-contrast='high']) .flotante { outline: 3px solid #fff; }
</style>

---
// Seguridad del paciente: metas institucionales y recomendaciones para pacientes y familias.
// Los textos salen de src/data/seguridad.json (editable en el panel, en "Datos del sitio").
import type { Lang } from '../i18n/content';
import { links } from '../i18n/content';
import { r, type RouteKey } from '../i18n/routes';
import data from '../data/seguridad.json';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
type Txt = { es: string; en: string };
const tx = (x: Txt) => (en ? x.en || x.es : x.es);
const t = en
  ? {
      goals: 'Our patient safety goals',
      goalsLead: 'Everyone on our team works every day toward these goals.',
      tips: 'How you can help us keep you safe',
      tipsLead: 'You and your family are part of the care team. These simple practices help prevent mistakes.',
      alertTitle: 'Does something not feel safe?',
      alertText: 'Tell the person caring for you right away. You can also write to us through the PQRS form or on WhatsApp. Your feedback helps us learn and improve.',
      pqrs: 'PQRS form',
      wa: 'WhatsApp',
      policy: 'Patient safety policy',
      rights: 'Patient rights and responsibilities',
      opens: 'opens in a new tab',
    }
  : {
      goals: 'Nuestras metas de seguridad',
      goalsLead: 'Todo nuestro equipo trabaja cada día para cumplirlas.',
      tips: 'Cómo puede ayudarnos a cuidarle',
      tipsLead: 'Usted y su familia hacen parte del equipo de atención. Estas prácticas sencillas ayudan a prevenir errores.',
      alertTitle: '¿Algo no le parece seguro?',
      alertText: 'Díganoslo de inmediato al personal que le atiende. También puede escribirnos en el formulario de PQRS o por WhatsApp. Su opinión nos ayuda a aprender y a mejorar.',
      pqrs: 'Formulario de PQRS',
      wa: 'WhatsApp',
      policy: 'Política de seguridad del paciente',
      rights: 'Derechos y deberes de los pacientes',
      opens: 'se abre en una pestaña nueva',
    };
const politicaHref = `${r(lang, 'politicas')}#${en ? 'patient-safety-policy' : 'política-de-seguridad-del-paciente'}`;
---
<div class="sgp">
  <section class="sgp-sec" aria-labelledby="sgp-metas">
    <header class="sgp-cab">
      <h2 id="sgp-metas">{t.goals}</h2>
      <p>{t.goalsLead}</p>
    </header>
    <ol class="sgp-metas" data-stagger>
      {data.metas.map((m, i) => (
        <li class="sgp-meta" data-stagger-item>
          <span class="sgp-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="sgp-ico" aria-hidden="true"><Icon name={m.icono} /></span>
          <h3>{tx(m.titulo)}</h3>
          <p>{tx(m.texto)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sgp-sec" aria-labelledby="sgp-consejos">
    <header class="sgp-cab">
      <h2 id="sgp-consejos">{t.tips}</h2>
      <p>{t.tipsLead}</p>
    </header>
    <ul class="sgp-consejos" data-stagger>
      {data.consejos.map((c) => (
        <li class="sgp-consejo" data-stagger-item>
          <h3><span class="sgp-ico sgp-ico-s" aria-hidden="true"><Icon name={c.icono} /></span>{tx(c.titulo)}</h3>
          <ul>
            {c.items.map((x) => (
              <li><Icon name="check" />{tx(x)}</li>
            ))}
          </ul>
          {c.enlace && (
            <a class="sgp-enlace" href={r(lang, c.enlace.ruta as RouteKey)}>{tx(c.enlace.texto)}<Icon name="arrow" /></a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <aside class="sgp-alerta" aria-labelledby="sgp-alerta-t" data-reveal>
    <span class="sgp-alerta-ico" aria-hidden="true"><Icon name="shield" /></span>
    <div class="sgp-alerta-txt">
      <h2 id="sgp-alerta-t">{t.alertTitle}</h2>
      <p>{t.alertText}</p>
      <div class="sgp-botones">
        <a class="btn btn-primario" href={links.pqrs} target="_blank" rel="noopener">{t.pqrs}<Icon name="external" /><span class="visualmente-oculto"> ({t.opens})</span></a>
        <a class="btn btn-borde" href={links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />{t.wa}<span class="visualmente-oculto"> ({t.opens})</span></a>
      </div>
      <ul class="sgp-mas">
        <li><a href={politicaHref}>{t.policy}</a></li>
        <li><a href={r(lang, 'derechos')}>{t.rights}</a></li>
      </ul>
    </div>
  </aside>
</div>

<style>
  .sgp { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); }
  .sgp-sec { display: grid; gap: 1.4rem; }
  .sgp-cab { display: grid; gap: .4rem; max-width: 46rem; }
  .sgp-cab h2 { font-size: var(--t-5); }
  .sgp-cab p { color: var(--tinta-2); }

  .sgp-metas { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr)); gap: 1rem; counter-reset: none; }
  .sgp-meta { position: relative; display: grid; gap: .55rem; align-content: start; padding: 1.4rem 1.4rem 1.5rem; border-radius: var(--radio-l, 22px); border: 1px solid var(--linea); background: var(--papel); overflow: hidden; transition: border-color .3s, box-shadow .4s, transform .4s var(--ease); }
  .sgp-meta::after { content: ''; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--rojo); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); }
  .sgp-meta:hover { border-color: rgb(159 39 40 / .35); box-shadow: 0 18px 40px -28px rgb(28 26 25 / .45); transform: translateY(-2px); }
  .sgp-meta:hover::after { transform: scaleX(1); }
  .sgp-num { position: absolute; top: .9rem; right: 1.1rem; font-family: var(--display); font-weight: 800; font-size: 2.2rem; line-height: 1; color: rgb(159 39 40 / .12); }
  .sgp-meta h3 { font-size: var(--t-2); line-height: 1.25; padding-right: 2.5rem; }
  .sgp-meta p { font-size: var(--t-0); color: var(--tinta-2); line-height: 1.5; }

  .sgp-ico { width: 2.9rem; height: 2.9rem; border-radius: 50%; display: grid; place-items: center; background: rgb(159 39 40 / .08); color: var(--rojo); flex: none; }
  .sgp-ico :global(.icon) { width: 1.45rem; height: 1.45rem; }
  .sgp-ico-s { width: 2.4rem; height: 2.4rem; }
  .sgp-ico-s :global(.icon) { width: 1.2rem; height: 1.2rem; }

  .sgp-consejos { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
  .sgp-consejo { display: grid; gap: .9rem; align-content: start; padding: 1.3rem 1.4rem 1.4rem; border-radius: var(--radio-m); background: var(--niebla); }
  .sgp-consejo h3 { display: flex; align-items: center; gap: .75rem; font-size: var(--t-2); line-height: 1.25; }
  .sgp-consejo ul { list-style: none; display: grid; gap: .6rem; }
  .sgp-consejo li { display: flex; gap: .6rem; align-items: flex-start; font-size: var(--t-0); line-height: 1.5; }
  .sgp-consejo li :global(.icon) { width: 1.05rem; height: 1.05rem; color: var(--rojo); flex: none; margin-top: .2rem; stroke-width: 2.4; }
  .sgp-enlace { display: inline-flex; align-items: center; gap: .4rem; justify-self: start; font-weight: 600; font-size: var(--t-0); color: var(--tinta); }
  .sgp-enlace :global(.icon) { width: 1rem; height: 1rem; transition: transform .3s var(--ease); }
  .sgp-enlace:hover :global(.icon) { transform: translateX(3px); }

  .sgp-alerta { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem 1.4rem; padding: clamp(1.4rem, 3vw, 2rem); border-radius: var(--radio-l, 22px); background: rgb(159 39 40 / .06); border: 1px solid rgb(159 39 40 / .2); }
  .sgp-alerta-ico { width: 3.4rem; height: 3.4rem; border-radius: 50%; display: grid; place-items: center; background: var(--rojo); color: #fff; }
  .sgp-alerta-ico :global(.icon) { width: 1.7rem; height: 1.7rem; }
  .sgp-alerta-txt { display: grid; gap: .8rem; }
  .sgp-alerta h2 { font-size: var(--t-4); }
  .sgp-botones { display: flex; flex-wrap: wrap; gap: .7rem; }
  .sgp-botones .btn :global(.icon) { width: 1.05rem; height: 1.05rem; }
  .sgp-mas { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-size: var(--t-0); }
  .sgp-mas a { color: var(--tinta); font-weight: 600; }
  @media (max-width: 560px) {
    .sgp-alerta { grid-template-columns: minmax(0, 1fr); }
    .sgp-meta { grid-template-columns: auto minmax(0, 1fr); column-gap: 1rem; padding: 1.2rem; }
    .sgp-meta .sgp-ico { grid-row: span 2; }
    .sgp-meta h3 { align-self: center; }
    .sgp-num { font-size: 1.6rem; top: .8rem; right: .9rem; }
  }
  @media (prefers-reduced-motion: reduce) { .sgp-meta, .sgp-meta::after, .sgp-enlace :global(.icon) { transition: none; } .sgp-meta:hover { transform: none; } }
  :global(:root[data-contrast='high']) .sgp-alerta-ico { background: #000; }
</style>

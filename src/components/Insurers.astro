---
// Convenios: logos de las EPS y aseguradoras en dos filas que se deslizan (con botón para pausar).
// Con movimiento reducido se muestran quietos, en una cuadrícula. Los datos se editan en el panel:
// Datos del sitio > Convenios.
import type { Lang } from '../i18n/content';
import { content, insurers } from '../i18n/content';
import { Image } from 'astro:assets';
import { logoConvenio, anchoLogo } from '../lib/convenios';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].insurers;
const items = insurers.map((c) => {
  const meta = logoConvenio(c.logo);
  const w = meta ? anchoLogo(meta, 24, 9.6, 3.8) : 0;
  const px = Math.round(w * 16);
  const anchos = meta ? [px, px * 2].filter((x) => x <= meta.width) : [];
  return { ...c, meta, w, px, anchos: anchos.length ? anchos : meta ? [meta.width] : [] };
});
const mitad = Math.ceil(items.length / 2);
const filas = [items.slice(0, mitad), items.slice(mitad)];
---
<section class="convenios seccion" aria-labelledby="convenios-titulo" data-marquee>
  <div class="contenedor conv-cab">
    <header class="sec-cab">
      <h2 id="convenios-titulo" data-split>{t.title}</h2>
      <p data-reveal>{t.lead}</p>
    </header>
    <button class="conv-pausa" type="button" aria-pressed="false" data-marquee-btn data-pause={t.pause} data-play={t.play}>
      <Icon name="pause" /><span data-label>{t.pause}</span>
    </button>
  </div>

  <!-- Lista para lectores de pantalla; con movimiento reducido se ve como cuadrícula -->
  <div class="contenedor">
    <ul class="conv-rejilla">
      {items.map((c) => (
        <li class="ficha">
          {c.meta ? (
            <Image src={c.meta} alt={c.nombre} widths={c.anchos} sizes={`${c.px}px`} format="webp" quality={88} style={`--w:${c.w}`} loading="lazy" />
          ) : <span class="ficha-nombre">{c.nombre}</span>}
        </li>
      ))}
    </ul>
  </div>

  <div class="marquesina" aria-hidden="true">
    {filas.map((fila, r) => (
      <div class:list={['fila', { inversa: r === 1 }]}>
        <div class="pista">
          {[0, 1, 2].map(() => fila.map((c) => (
            <span class="ficha">
              {c.meta ? (
                <Image src={c.meta} alt="" widths={c.anchos} sizes={`${c.px}px`} format="webp" quality={88} style={`--w:${c.w}`} loading="lazy" />
              ) : <span class="ficha-nombre">{c.nombre}</span>}
            </span>
          )))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-marquee]');
  const btn = sec?.querySelector<HTMLButtonElement>('[data-marquee-btn]');
  btn?.addEventListener('click', () => {
    const paused = sec!.classList.toggle('pausada');
    btn.setAttribute('aria-pressed', String(paused));
    btn.querySelector('[data-label]')!.textContent = paused ? btn.dataset.play! : btn.dataset.pause!;
    btn.querySelector('svg')?.classList.toggle('icon-play-on', paused);
  });
</script>

<style>
  .convenios { --escala: 1; background: var(--papel); overflow: hidden; padding-bottom: clamp(4rem, 6vw, 7rem); }
  .conv-cab { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .conv-pausa { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); padding: .6rem 1rem; border-radius: 999px; border: 1px solid var(--linea); background: var(--papel); cursor: pointer; font-weight: 600; font-size: var(--t-0); color: var(--tinta); white-space: nowrap; }
  .conv-pausa:hover { border-color: var(--tinta); }
  .conv-pausa :global(.icon) { width: 1rem; height: 1rem; }

  /* Ficha de cada convenio: logo a color sobre blanco, todos con el mismo peso visual */
  .ficha {
    flex: none; display: grid; place-items: center;
    width: calc(12rem * var(--escala)); height: calc(6rem * var(--escala));
    border-radius: var(--radio-m); background: #fff; border: 1px solid var(--linea);
    transition: border-color .3s, transform .5s var(--ease), box-shadow .5s var(--ease);
  }
  .ficha :global(img) { display: block; width: calc(var(--w) * 1rem * var(--escala)); height: auto; }
  .ficha-nombre { font: 600 var(--t-2) / 1.2 var(--display); color: var(--tinta); text-align: center; padding: 0 1rem; }

  .marquesina { display: grid; gap: 1rem; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .fila { display: flex; overflow: hidden; padding: .4rem 0; }
  .pista { display: flex; flex: none; animation: deslizar 60s linear infinite; }
  .pista .ficha { margin-right: 1rem; }
  .inversa .pista { animation-direction: reverse; animation-duration: 68s; }
  .convenios:hover .pista, .convenios.pausada .pista { animation-play-state: paused; }
  .pista .ficha:hover { border-color: rgb(159 39 40 / .35); transform: translateY(-3px); box-shadow: 0 18px 36px -24px rgb(var(--sombra) / .5); }
  @keyframes deslizar { to { transform: translateX(-33.333%); } }

  /* La cuadrícula solo se ve con movimiento reducido; si no, queda para lectores de pantalla */
  .conv-rejilla { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; list-style: none; }

  @media (max-width: 640px) {
    .convenios { --escala: .78; }
    .conv-cab { display: grid; }
    .conv-pausa { justify-self: start; margin-top: -1.5rem; }
    .marquesina { gap: .7rem; }
    .pista .ficha { margin-right: .7rem; }
  }
  :global(:root[data-contrast='high']) .ficha { border: 2px solid #000; }
  :global(:root[data-motion='reduced']) .marquesina, :global(:root[data-motion='reduced']) .conv-pausa { display: none; }
  :global(:root[data-motion='reduced']) .conv-rejilla { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal; display: grid; grid-template-columns: repeat(auto-fill, minmax(calc(12rem * var(--escala)), 1fr)); gap: 1rem; }
  :global(:root[data-motion='reduced']) .conv-rejilla .ficha { width: auto; }
  @media (prefers-reduced-motion: reduce) {
    .marquesina, .conv-pausa { display: none; }
    .conv-rejilla { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal; display: grid; grid-template-columns: repeat(auto-fill, minmax(calc(12rem * var(--escala)), 1fr)); gap: 1rem; }
    .conv-rejilla .ficha { width: auto; }
  }
</style>

---
// Chat en línea de tawk.to (el mismo de la página anterior). Los códigos se cambian en el panel:
// Datos del sitio > Contacto, sedes y horarios > Chat en línea.
// El script de tawk.to pesa bastante, así que se carga con la primera interacción o unos segundos después de abrir la página.
import contacto from '../data/contacto.json';
const chat = (contacto as { chat?: { activo?: boolean; propiedad?: string; widget?: string } }).chat;
const activo = Boolean(chat?.activo && chat.propiedad);
---
{activo && <div hidden data-chat data-prop={chat!.propiedad} data-widget={chat!.widget || 'default'}></div>}

<script>
  type TawkApi = {
    customStyle?: unknown;
    onLoad?: () => void;
    onChatMinimized?: () => void;
    showWidget?: () => void;
    hideWidget?: () => void;
    isChatMaximized?: () => boolean;
  };
  const el = document.querySelector<HTMLElement>('[data-chat]');
  if (el && /^[a-z0-9]+$/i.test(el.dataset.prop || '') && /^[a-z0-9]+$/i.test(el.dataset.widget || '')) {
    const w = window as unknown as { Tawk_API?: TawkApi; Tawk_LoadStart?: Date };
    const api: TawkApi = (w.Tawk_API = w.Tawk_API || {});
    // Abajo a la derecha, encima del botón de WhatsApp (3,5 rem a 18 px del borde)
    api.customStyle = {
      visibility: {
        desktop: { position: 'br', xOffset: 16, yOffset: 88 },
        mobile: { position: 'br', xOffset: 14, yOffset: 86 },
      },
    };
    // El chat aparece y se oculta junto con los otros botones flotantes, y se esconde mientras el menú del celular está abierto.
    // Si la persona tiene la conversación abierta, no se le cierra.
    const wa = document.querySelector('.wa-flotante');
    const menuBtn = document.querySelector('[data-menu-btn]');
    let listo = false;
    let mostrado: boolean | null = null;
    const sync = () => {
      if (!listo) return;
      const on = (!wa || wa.classList.contains('visible')) && menuBtn?.getAttribute('aria-expanded') !== 'true';
      if (on === mostrado) return;
      if (on) api.showWidget?.();
      else if (api.isChatMaximized?.()) return;
      else api.hideWidget?.();
      mostrado = on;
    };
    api.onLoad = () => { listo = true; mostrado = null; sync(); };
    api.onChatMinimized = () => { mostrado = null; sync(); };
    const obs = new MutationObserver(sync);
    if (wa) obs.observe(wa, { attributes: true, attributeFilter: ['class'] });
    if (menuBtn) obs.observe(menuBtn, { attributes: true, attributeFilter: ['aria-expanded'] });

    const eventos = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
    let pedido = false;
    const cargar = () => {
      if (pedido) return;
      pedido = true;
      eventos.forEach((e) => removeEventListener(e, cargar));
      w.Tawk_LoadStart = new Date();
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://embed.tawk.to/${el.dataset.prop}/${el.dataset.widget}`;
      s.charset = 'UTF-8';
      s.setAttribute('crossorigin', '*');
      document.body.appendChild(s);
    };
    eventos.forEach((e) => addEventListener(e, cargar, { passive: true }));
    if (document.readyState === 'complete') setTimeout(cargar, 6000);
    else addEventListener('load', () => setTimeout(cargar, 6000), { once: true });
  }
</script>

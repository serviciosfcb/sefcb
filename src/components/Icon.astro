---
// Iconos lineales propios, 24 px, trazo de 1,8. Decorativos: el texto vecino da el significado.
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={['icon', `icon-${name}`, cls]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {name === 'book' && (
    <>
      <rect x="3.5" y="5" width="17" height="15" rx="2.5" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" />
      <path class="anim-check" d="M8.5 14.5l2.3 2.3 4.7-4.7" />
    </>
  )}
  {name === 'results' && (
    <>
      <path d="M6 3.5h8l4 4v13H6z" />
      <path d="M14 3.5v4h4" />
      <g class="anim-down"><path d="M12 10.5v6M9.3 13.9 12 16.6l2.7-2.7" /></g>
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6" />
      <path d="M15 15l5 5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'prep' && (
    <>
      <rect x="5" y="4.5" width="14" height="16" rx="2" />
      <path d="M9 3h6v3H9z" />
      <path class="anim-lines" d="M8.5 11h7M8.5 14.5h7M8.5 18h4" />
    </>
  )}
  {name === 'pay' && (
    <>
      <rect class="anim-card" x="3" y="6" width="18" height="12.5" rx="2.5" />
      <path d="M3 10h18M6.5 15h4" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4.2 19.8l1.1-3.9A8.2 8.2 0 1 1 8.4 19z" />
      <path d="M9.1 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.2-.1.3 0 .5a5.6 5.6 0 0 0 2.7 2.4c.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.6 1.7-1.6 1.8-1.2.1-3.3-.4-5.1-2.3-1.6-1.7-2-3.6-1.5-4.7z" />
    </>
  )}
  {name === 'phone' && <path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.4" />
    </>
  )}
  {name === 'access' && (
    <>
      <circle cx="12" cy="4.6" r="1.8" />
      <path d="M4.5 8.2c2.5.9 5 1.3 7.5 1.3s5-.4 7.5-1.3M12 9.5v4.3M12 13.8l-3.2 6.7M12 13.8l3.2 6.7" />
    </>
  )}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h10" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'up' && <path d="M12 19V5M6 11l6-6 6 6" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" />}
  {name === 'pause' && <path d="M8.5 5v14M15.5 5v14" />}
  {name === 'award' && (
    <>
      <circle cx="12" cy="9" r="5.5" />
      <path d="M8.6 13.4 7 21l5-2.6 5 2.6-1.6-7.6" />
      <path d="M9.8 9l1.5 1.5L14.4 7.6" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3l7.5 2.8v5.5c0 4.6-3.2 8.4-7.5 9.7-4.3-1.3-7.5-5.1-7.5-9.7V5.8z" />
      <path d="M8.7 12l2.3 2.3 4.4-4.5" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'copy' && (
    <>
      <rect x="8.5" y="8.5" width="11" height="11" rx="2" />
      <path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" />
    </>
  )}
  {name === 'speaker' && (
    <>
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
      <path d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M3.5 12h17M12 3.5c2.4 2.4 3.5 5.4 3.5 8.5s-1.1 6.1-3.5 8.5c-2.4-2.4-3.5-5.4-3.5-8.5S9.6 5.9 12 3.5z" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
      <path d="M4 7l8 6 8-6" />
    </>
  )}
  {name === 'document' && (
    <>
      <path d="M6 3.5h8l4 4v13H6z" />
      <path d="M14 3.5v4h4M9 12h6M9 15.5h6" />
    </>
  )}
  {name === 'facebook' && <path d="M14.5 8.5H17V5h-2.5A3.5 3.5 0 0 0 11 8.5V11H8.5v3.5H11V21h3.5v-6.5H17l.5-3.5h-3V9a.5.5 0 0 1 .5-.5z" />}
  {name === 'instagram' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="4.5" />
      <circle cx="12" cy="12" r="3.6" />
      <path d="M16.8 7.2h.01" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <rect x="3" y="6" width="18" height="12" rx="3.5" />
      <path d="M10.5 9.5v5l4.3-2.5z" />
    </>
  )}
</svg>

---
// Ilustraciones técnicas de cada servicio, dibujadas con datos reales de su disciplina.
// Se animan cuando su contenedor recibe la clase .activa.
import type { ServiceKey } from '../i18n/content';
interface Props { kind: ServiceKey; labels?: string[]; uid: string }
const { kind, labels = [], uid } = Astro.props;
const id = (n: string) => `${n}-${uid}`;

const W = 480, H = 360;
const f = (n: number) => n.toFixed(1);

// Electrocardiograma: P, QRS y T con proporciones a 25 mm/s
const g = (ph: number, c: number, w: number, a: number) => a * Math.exp(-(((ph - c) / w) ** 2));
const beat = (ph: number, lead: 'I' | 'II' | 'V2') => {
  if (lead === 'V2') return g(ph, .14, .03, .08) + g(ph, .27, .012, .35) + g(ph, .3, .016, -1) + g(ph, .55, .05, .45);
  const k = lead === 'I' ? .62 : 1;
  return k * (g(ph, .14, .03, .12) + g(ph, .265, .01, -.1) + g(ph, .29, .011, 1) + g(ph, .315, .012, -.22) + g(ph, .55, .05, .28));
};
const ecgPath = (y0: number, lead: 'I' | 'II' | 'V2', amp: number, offset: number) => {
  let d = ''; const L = 132;
  for (let x = 28; x <= 452; x += 1.5) {
    const y = y0 - beat((((x - 28 + offset) % L) + L) % L / L, lead) * amp;
    d += (d ? 'L' : 'M') + f(x) + ' ' + f(y);
  }
  return d;
};
const ecgLeads = [
  { y: 96, lead: 'I' as const, amp: 46, off: 30 },
  { y: 196, lead: 'II' as const, amp: 62, off: 30 },
  { y: 300, lead: 'V2' as const, amp: 44, off: 30 },
];

// Mapa polar de 17 segmentos (modelo de la AHA)
const cx = 220, cy = 180;
const arc = (r0: number, r1: number, a0: number, a1: number) => {
  const p = (r: number, a: number) => `${f(cx + r * Math.cos(a))} ${f(cy - r * Math.sin(a))}`;
  const large = a1 - a0 > Math.PI ? 1 : 0;
  return `M${p(r1, a0)} A${r1} ${r1} 0 ${large} 0 ${p(r1, a1)} L${p(r0, a1)} A${r0} ${r0} 0 ${large} 1 ${p(r0, a0)} Z`;
};
const deg = Math.PI / 180;
const perf = [.96, .9, .74, .58, .82, .93, .97, .88, .66, .5, .79, .95, .92, .7, .55, .9, .86]; // captación relativa por segmento
const scale = (v: number) => {
  // escala térmica en tonos de la marca: carbón → rojo → rosa → blanco
  const stops = [[38, 24, 23], [109, 26, 28], [159, 39, 40], [226, 72, 77], [243, 161, 159], [255, 244, 242]];
  const t = Math.min(.999, Math.max(0, v)) * (stops.length - 1); const i = Math.floor(t); const u = t - i;
  const c = stops[i].map((s, k) => Math.round(s + (stops[i + 1][k] - s) * u));
  return `rgb(${c.join(' ')})`;
};
const segs: { d: string; fill: string; ring: number }[] = [];
for (let i = 0; i < 6; i++) segs.push({ d: arc(98, 136, (60 + i * 60) * deg, (120 + i * 60) * deg), fill: scale(perf[i]), ring: 3 });
for (let i = 0; i < 6; i++) segs.push({ d: arc(62, 98, (60 + i * 60) * deg, (120 + i * 60) * deg), fill: scale(perf[6 + i]), ring: 2 });
for (let i = 0; i < 4; i++) segs.push({ d: arc(28, 62, (45 + i * 90) * deg, (135 + i * 90) * deg), fill: scale(perf[12 + i]), ring: 1 });

// Fonocardiograma: ráfagas de S1 y S2
let pcg = '';
for (let x = 28; x <= 452; x += 1) {
  const env = [118, 338].reduce((s, c) => s + 62 * Math.exp(-(((x - c) / 13) ** 2)), 0) + [212, 432].reduce((s, c) => s + 44 * Math.exp(-(((x - c) / 9) ** 2)), 0);
  const y = 200 - env * Math.sin(x * 1.9) * (.65 + .35 * Math.cos(x * .53));
  pcg += (pcg ? 'L' : 'M') + f(x) + ' ' + f(y);
}
let pcgEcg = '';
for (let x = 28; x <= 452; x += 1.5) {
  const ph = ((((x - 28 + 98) % 220) + 220) % 220) / 220;
  pcgEcg += (pcgEcg ? 'L' : 'M') + f(x) + ' ' + f(84 - beat(ph, 'II') * 30);
}

// Mapa de HORMESIS: cuatro pilares alrededor de la capacidad de adaptación (Cartilla 0, visual 7.1)
const hx = 240, hy = 180, hr0 = 66, hr1 = 152;
const sector = (r0: number, r1: number, a0: number, a1: number) => {
  const p = (r: number, a: number) => `${f(hx + r * Math.cos(a))} ${f(hy - r * Math.sin(a))}`;
  return `M${p(r1, a0)} A${r1} ${r1} 0 0 0 ${p(r1, a1)} L${p(r0, a1)} A${r0} ${r0} 0 0 1 ${p(r0, a0)} Z`;
};
// Del primero al cuarto, en el sentido del reloj desde arriba a la izquierda; los colores se alternan para que ningún pilar parezca más importante
const pilares = [135, 45, -45, -135].map((c, i) => {
  const arriba = c > 0;
  const bx = hx + 104 * Math.cos(c * deg) * (arriba ? 1 : 1.04), by = hy - 104 * Math.sin(c * deg);
  const nombre = (labels[i] ?? '').split(' ');
  const lineas = nombre.length > 1 ? [nombre[0], nombre.slice(1).join(' ')] : nombre;
  // Arriba: el icono hacia afuera y el nombre hacia el centro; abajo, al revés
  const iy = arriba ? by - 20 : by + 26;
  const ty = arriba ? by + 18 : by - (lineas.length > 1 ? 14 : 4);
  return { d: sector(hr0, hr1, (c - 42) * deg, (c + 42) * deg), bx: f(bx), iy: f(iy), ty, lineas, i };
});
// Puntos de unión entre pilares: se influyen entre sí
const uniones = [90, 0, -90, 180].map((a) => ({ x: f(hx + 109 * Math.cos(a * deg)), y: f(hy - 109 * Math.sin(a * deg)) }));

// Goniómetro: transportador de 0° a 180° y flexión de rodilla de 120°
const gx = 240, gy = 262, flex = 120;
const polar = (r: number, aDeg: number) => [gx + r * Math.cos(aDeg * deg), gy - r * Math.sin(aDeg * deg)];
const ticks = Array.from({ length: 37 }, (_, i) => i * 5).map((a) => {
  const major = a % 45 === 0, mid = a % 10 === 0;
  const [x1, y1] = polar(major ? 150 : mid ? 158 : 163, a); const [x2, y2] = polar(170, a);
  return { x1: f(x1), y1: f(y1), x2: f(x2), y2: f(y2), major };
});
const tickLabels = [0, 45, 90, 135, 180].map((a) => { const [x, y] = polar(192, a); return { a, x: f(x), y: f(y + 5) }; });
const [ax, ay] = polar(78, flex);
const angleArc = `M${f(gx + 78)} ${gy} A78 78 0 0 0 ${f(ax)} ${f(ay)}`;
const [lx, ly] = polar(112, flex / 2);
---
<svg class={`vis vis-${kind}`} viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false">
  {kind === 'noinvasiva' && (
    <>
      <defs>
        <pattern id={id("mm")} width="8" height="8" patternUnits="userSpaceOnUse"><path d="M8 0H0V8" fill="none" class="mm" /></pattern>
        <pattern id={id("cinco")} width="40" height="40" patternUnits="userSpaceOnUse"><rect width="40" height="40" fill={`url(#${id("mm")})`} /><path d="M40 0H0V40" fill="none" class="cinco" /></pattern>
      </defs>
      <rect x="8" y="16" width="464" height="328" rx="14" fill={`url(#${id("cinco")})`} class="papel" />
      {ecgLeads.map((l, i) => (
        <>
          <text x="34" y={l.y - 52} class="rotulo">{l.lead}</text>
          <path d={ecgPath(l.y, l.lead, l.amp, l.off)} data-draw class="traza" style={`--d:${i * .25}s`} />
        </>
      ))}
    </>
  )}

  {kind === 'nuclear' && (
    <>
      <circle cx={cx} cy={cy} r="150" class="anillo-guia" />
      <g class="mapa">
        {segs.map((s, i) => <path d={s.d} fill={s.fill} class="seg" style={`--d:${(3 - s.ring) * .14 + i * .018}s`} />)}
        <circle cx={cx} cy={cy} r="28" fill={scale(perf[16])} class="seg" style="--d:.0s" />
      </g>
      <circle cx={cx} cy={cy} r="150" class="barrido" />
      <g class="leyenda">
        <defs><linearGradient id={id("esc")} x1="0" y1="1" x2="0" y2="0">{[0, .2, .4, .6, .8, 1].map((v) => <stop offset={v} stop-color={scale(v)} />)}</linearGradient></defs>
        <rect x="414" y="70" width="14" height="220" rx="7" fill={`url(#${id("esc")})`} />
        <text x="438" y="76" class="rotulo">100%</text>
        <text x="438" y="292" class="rotulo">0%</text>
      </g>
    </>
  )}

  {kind === 'intervencionismo' && (
    <>
      <g class="fluoro"><circle cx="250" cy="185" r="165" /></g>
      <path class="cateter" data-draw d="M470 372 C 420 310, 330 268, 300 206 S 262 112, 250 86" />
      <g class="vasos">
        <path class="v v-1" data-draw style="--d:.55s" d="M250 86 C 262 93, 272 100, 284 108" />
        <path class="v v-1" data-draw style="--d:.75s" d="M284 108 C 272 160, 262 214, 248 312" />
        <path class="v v-1" data-draw style="--d:.75s" d="M284 108 C 332 112, 372 142, 386 192 S 382 254, 370 290" />
        <path class="v v-1" data-draw style="--d:.6s" d="M244 88 C 202 98, 160 124, 148 172 S 160 254, 202 296" />
        <path class="v v-2" data-draw style="--d:1s" d="M277 152 C 300 170, 318 192, 332 226" />
        <path class="v v-2" data-draw style="--d:1.1s" d="M267 208 C 290 226, 300 248, 308 276" />
        <path class="v v-2" data-draw style="--d:1.05s" d="M352 128 C 374 160, 384 182, 404 204" />
        <path class="v v-2" data-draw style="--d:1s" d="M152 204 C 130 222, 120 242, 118 266" />
        <path class="v v-3" data-draw style="--d:1.25s" d="M258 254 C 238 270, 226 286, 222 306" />
        <path class="v v-3" data-draw style="--d:1.25s" d="M380 236 C 400 250, 410 264, 414 284" />
      </g>
    </>
  )}

  {kind === 'consulta' && (
    <>
      <line x1="28" y1="200" x2="452" y2="200" class="base" />
      <path d={pcgEcg} data-draw class="traza-fina" />
      <path d={pcg} data-draw class="traza" />
      {[118, 338].map((x) => <text x={x} y="300" class="rotulo centro">{labels[0] ?? 'S1'}</text>)}
      {[212, 432].map((x) => <text x={x} y="300" class="rotulo centro">{labels[1] ?? 'S2'}</text>)}
      {[118, 212, 338, 432].map((x) => <line x1={x} y1="262" x2={x} y2="280" class="marca" />)}
    </>
  )}

  {kind === 'terapia' && (
    <>
      <path class="transportador" d={`M${gx - 170} ${gy} A170 170 0 0 1 ${gx + 170} ${gy}`} />
      <g class="ticks">
        {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class:list={{ mayor: t.major }} />)}
      </g>
      {tickLabels.map((l) => <text x={l.x} y={l.y} class="rotulo centro">{l.a}°</text>)}
      <line x1={gx} y1={gy} x2={gx + 150} y2={gy} class="brazo-fijo" />
      <path d={angleArc} data-draw class="angulo" />
      <g class="brazo-movil" style={`--flex:-${flex}deg; transform-origin:${gx}px ${gy}px`}>
        <line x1={gx} y1={gy} x2={gx + 150} y2={gy} />
      </g>
      <circle cx={gx} cy={gy} r="13" class="articulacion" />
      <text x={f(lx)} y={f(ly)} class="lectura centro">{flex}°</text>
    </>
  )}

  {kind === 'transporte' && (
    <>
      <g class="calles">
        {[60, 120, 180, 240, 300].map((y) => <line x1="0" y1={y} x2="480" y2={y - 30} />)}
        {[70, 150, 230, 310, 390].map((x) => <line x1={x} y1="0" x2={x + 40} y2="360" />)}
      </g>
      <path class="rio" d="M-10 330 C 80 300, 120 250, 170 230 S 260 180, 300 120 S 380 40, 490 20" />
      <path class="ruta" data-draw d="M112 262 C 150 250, 168 232, 190 214 S 236 196, 262 178 S 318 150, 354 118" />
      <g class="pin" transform="translate(112 262)"><circle r="20" class="pulso" /><circle r="7" class="punto" /></g>
      <g class="pin" transform="translate(354 118)"><circle r="20" class="pulso" style="animation-delay:.8s" /><circle r="7" class="punto" /></g>
      <text x="112" y="300" class="rotulo centro">{labels[0]}</text>
      <text x="354" y="88" class="rotulo centro">{labels[1]}</text>
      <circle r="6" class="movil" />
    </>
  )}

  {kind === 'obesidad' && (
    <>
      <circle cx={hx} cy={hy} r="168" class="anillo-guia" />
      <circle cx={hx} cy={hy} r="168" class="barrido" />
      {pilares.map((p) => (
        <g class={`pilar pl${p.i + 1}`} style={`--d:${p.i * .18}s`}>
          <path d={p.d} class="sector" />
          <g class="pl-contenido" transform={`translate(${p.bx} ${p.iy})`}>
            {p.i === 0 && (
              <>
                <path d="M0 -5 C -4 -9 -13 -8 -13 1 C -13 9 -6 14 0 12 C 6 14 13 9 13 1 C 13 -8 4 -9 0 -5 Z" />
                <path d="M0 -5 C 0 -9 1 -12 4 -14" />
                <path d="M2 -9 C 5 -14 10 -13 11 -12 C 10 -8 6 -7 2 -9 Z" />
              </>
            )}
            {p.i === 1 && (
              <>
                <circle cx="3" cy="-12" r="3.2" />
                <path d="M2 -7 L-1 3 L-7 12 M-1 3 L5 7 L5 14 M-8 -1 L-2 -6 L4 -3 L9 1" />
              </>
            )}
            {p.i === 2 && (
              <>
                <path d="M3 -12 A12 12 0 1 0 12 4 A9.5 9.5 0 0 1 3 -12 Z" />
                <path d="M11 -14 V-8 M8 -11 H14" />
              </>
            )}
            {p.i === 3 && (
              <path d="M-13 -5 H5 A4.5 4.5 0 1 0 0.5 -9.5 M-13 1 H9 A4.5 4.5 0 1 1 4.5 5.5 M-13 7 H-1" />
            )}
          </g>
          <text x={p.bx} y={p.ty} class="pl-nombre centro">
            {p.lineas.map((l, k) => <tspan x={p.bx} dy={k ? 15 : 0}>{l}</tspan>)}
          </text>
        </g>
      ))}
      {uniones.map((u, i) => <circle cx={u.x} cy={u.y} r="4.5" class="union" style={`--d:${1 + i * .5}s`} />)}
      <circle cx={hx} cy={hy} r="56" class="centro-pulso" />
      <g class="centro-hm">
        <circle cx={hx} cy={hy} r="56" />
        <text x={hx} y={hy - 4} class="hm-sub centro">{labels[4]}</text>
        <text x={hx} y={hy + 15} class="hm-titulo centro">{labels[5]}</text>
      </g>
    </>
  )}
</svg>

<style>
  .vis { width: 100%; height: auto; overflow: visible; }
  .rotulo { fill: rgb(245 244 242 / .62); font: 600 13px var(--texto); letter-spacing: .04em; }
  .centro { text-anchor: middle; }
  .grande { font-size: 15px; }

  /* ECG */
  .papel { opacity: .95; }
  .mm { stroke: rgb(226 72 77 / .12); stroke-width: .6; }
  .cinco { stroke: rgb(226 72 77 / .3); stroke-width: 1; }
  .traza { fill: none; stroke: #f5f4f2; stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); filter: drop-shadow(0 0 6px rgb(226 72 77 / .55)); }
  .traza-fina { fill: none; stroke: rgb(161 161 159 / .55); stroke-width: 1.4; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); }
  :global(.activa) .traza, :global(.activa) .traza-fina { animation: trazar 2.4s var(--ease-io) forwards; animation-delay: var(--d, 0s); }
  @keyframes trazar { to { stroke-dashoffset: 0; } }

  /* Mapa polar */
  .anillo-guia { fill: none; stroke: rgb(255 255 255 / .08); stroke-dasharray: 2 6; }
  .seg { stroke: #1c1a19; stroke-width: 2; transform-origin: 220px 180px; transform: scale(.6); opacity: 0; }
  :global(.activa) .seg { animation: segmento .9s var(--ease) forwards; animation-delay: var(--d); }
  @keyframes segmento { to { transform: none; opacity: 1; } }
  .barrido { fill: none; stroke: #e2484d; stroke-width: 2; stroke-dasharray: 75 868; stroke-dashoffset: 0; transform-origin: 220px 180px; opacity: 0; }
  :global(.activa) .barrido { opacity: .9; animation: girar 4s linear infinite; }
  @keyframes girar { to { transform: rotate(-360deg); } }

  /* Angiografía */
  .fluoro circle { fill: rgb(255 255 255 / .03); stroke: rgb(255 255 255 / .08); }
  .cateter { fill: none; stroke: rgb(161 161 159 / .7); stroke-width: 3; stroke-linecap: round; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); }
  .v { fill: none; stroke: #f5f4f2; stroke-linecap: round; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); filter: drop-shadow(0 0 8px rgb(226 72 77 / .5)); }
  .v-1 { stroke-width: 7; } .v-2 { stroke-width: 4.2; } .v-3 { stroke-width: 2.8; }
  :global(.activa) .cateter { animation: trazar 1s var(--ease-io) forwards; }
  :global(.activa) .v { animation: trazar 1.2s var(--ease) forwards; animation-delay: var(--d); }

  /* Fonocardiograma */
  .base { stroke: rgb(255 255 255 / .12); stroke-dasharray: 3 5; }
  .marca { stroke: rgb(226 72 77 / .7); stroke-width: 2; }

  /* Goniómetro */
  .transportador { fill: rgb(255 255 255 / .03); stroke: rgb(255 255 255 / .14); stroke-width: 1.5; }
  .ticks line { stroke: rgb(255 255 255 / .28); stroke-width: 1.2; }
  .ticks line.mayor { stroke: rgb(255 255 255 / .6); stroke-width: 2; }
  .brazo-fijo { stroke: #8c8b88; stroke-width: 16; stroke-linecap: round; }
  .brazo-movil line { stroke: #e2484d; stroke-width: 16; stroke-linecap: round; filter: drop-shadow(0 0 10px rgb(226 72 77 / .55)); }
  .brazo-movil { transform-box: view-box; transform: rotate(var(--flex)); }
  :global(.activa) .brazo-movil { animation: flexionar 1.8s var(--ease-io) both; }
  @keyframes flexionar { from { transform: rotate(0deg); } }
  .angulo { fill: none; stroke: #f5f4f2; stroke-width: 2.5; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); }
  :global(.activa) .angulo { animation: trazar 1.8s var(--ease-io) forwards; }
  .articulacion { fill: #1c1a19; stroke: #f5f4f2; stroke-width: 3; }
  .lectura { fill: #fff; font: 700 26px var(--display); letter-spacing: -.02em; opacity: 0; }
  :global(.activa) .lectura { animation: aparecer .6s var(--ease) 1.5s forwards; }
  @keyframes aparecer { to { opacity: 1; } }

  /* Traslado */
  .calles line { stroke: rgb(255 255 255 / .07); stroke-width: 10; }
  .rio { fill: none; stroke: rgb(161 161 159 / .16); stroke-width: 16; stroke-linecap: round; }
  .ruta { fill: none; stroke: #e2484d; stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: var(--len, none); stroke-dashoffset: var(--len, 0); }
  :global(.activa) .ruta { animation: trazar 1.6s var(--ease-io) forwards; }
  .punto { fill: #f5f4f2; stroke: #e2484d; stroke-width: 3; }
  .pulso { fill: rgb(226 72 77 / .25); transform-box: fill-box; transform-origin: center; animation: pulso 2.2s var(--ease) infinite; }
  @keyframes pulso { 0% { transform: scale(.4); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }
  .movil { fill: #fff; filter: drop-shadow(0 0 8px #e2484d); offset-path: path('M112 262 C 150 250, 168 232, 190 214 S 236 196, 262 178 S 318 150, 354 118'); offset-distance: 0%; opacity: 0; }
  :global(.activa) .movil { opacity: 1; animation: recorrer 3.6s var(--ease-io) 1.2s infinite; }
  @keyframes recorrer { 0% { offset-distance: 0%; } 70%, 100% { offset-distance: 100%; } }

  /* Pilares de HORMESIS */
  .vis-obesidad .barrido { transform-origin: 240px 180px; stroke-dasharray: 84 972; }
  .pilar { transform-origin: 240px 180px; transform: scale(.82); opacity: 0; }
  :global(.activa) .pilar { animation: segmento .9s var(--ease) forwards; animation-delay: var(--d); }
  .sector { stroke: #1c1a19; stroke-width: 3; }
  .pl1 .sector { fill: #9f2728; }
  .pl2 .sector { fill: rgb(161 161 159 / .42); }
  .pl3 .sector { fill: rgb(226 72 77 / .72); }
  .pl4 .sector { fill: rgb(245 244 242 / .2); }
  .pl-contenido path, .pl-contenido circle { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .pl-nombre { fill: #fff; font: 700 13.5px var(--texto); letter-spacing: .01em; }
  .union { fill: #f5f4f2; stroke: #1c1a19; stroke-width: 3; opacity: 0; }
  :global(.activa) .union { animation: aparecer .5s var(--ease) 1s forwards, latido 2s var(--ease-io) var(--d) infinite; }
  @keyframes latido { 0%, 100% { fill: #f5f4f2; } 50% { fill: #e2484d; } }
  .centro-hm circle { fill: #1c1a19; stroke: #e2484d; stroke-width: 2.5; }
  .centro-hm { opacity: 0; }
  :global(.activa) .centro-hm { animation: aparecer .7s var(--ease) .75s forwards; }
  .hm-sub { fill: rgb(245 244 242 / .7); font: 600 11.5px var(--texto); letter-spacing: .03em; }
  .hm-titulo { fill: #fff; font: 700 17px var(--display); letter-spacing: -.01em; }

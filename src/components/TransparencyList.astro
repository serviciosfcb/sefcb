---
// Categorías de transparencia y acceso a la información pública (Ley 1712 de 2014), editables desde el panel.
import type { Lang } from '../i18n/content';
import { content, links, financials } from '../i18n/content';
import { to, isExternal } from '../i18n/routes';
import transparencia from '../data/transparencia.json';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].pages;
const en = lang === 'en';
const hrefOf = (it: { ruta: string; archivo: string }) =>
  it.archivo === 'PQRS' ? links.pqrs : it.archivo ? it.archivo : it.ruta ? to(lang, it.ruta) : '';
---
<p class="leyenda"><span class="muestra" aria-hidden="true"></span>{t.noDoc}</p>
<ol class="categorias">
  {transparencia.secciones.map((sec, i) => (
    <li class="categoria" id={`categoria-${i + 1}`}>
      <h2><span class="num" aria-hidden="true">{i + 1}</span>{en ? sec.titulo_en || sec.titulo : sec.titulo}</h2>
      <ul class="items">
        {sec.items.map((it) => {
          const href = hrefOf(it);
          const label = en ? it.titulo_en || it.titulo : it.titulo;
          return href ? (
            <li><a href={href} rel={isExternal(href) ? 'noopener' : undefined} target={isExternal(href) ? '_blank' : undefined}>
              <span>{label}</span><Icon name={isExternal(href) ? 'external' : 'arrow'} />
              {isExternal(href) && <span class="visualmente-oculto"> ({t.opens})</span>}
            </a></li>
          ) : (
            <li class="sin-doc"><span>{label}</span></li>
          );
        })}
        {sec.estados && (
          <li class="estados">
            <span>{t.financials}</span>
            <span class="anios">
              {financials.map((f) => <a href={f.href} rel="noopener" target="_blank" aria-label={`${t.financials} ${f.year} (${t.opens})`}>{f.year}</a>)}
            </span>
          </li>
        )}
      </ul>
    </li>
  ))}
</ol>

<style>
  .leyenda { display: flex; align-items: center; gap: .6rem; font-size: var(--t-0); color: var(--tinta-2); margin: 2rem 0 1rem; }
  .muestra { width: 2rem; height: .6rem; border-radius: 4px; background: var(--niebla); border: 1px solid var(--linea); }
  .categorias { list-style: none; display: grid; gap: 1rem; }
  .categoria { border: 1px solid var(--linea); border-radius: var(--radio-m); padding: 1.3rem 1.4rem; background: var(--papel); scroll-margin-top: calc(var(--alto-cabecera) + 1rem); }
  .categoria h2 { display: flex; align-items: center; gap: .8rem; font-size: var(--t-3); margin-bottom: .8rem; }
  .num { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; flex: none; background: var(--tinta); color: #fff; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .items { list-style: none; display: grid; }
  .items li { border-top: 1px solid var(--linea); }
  .items a, .items li > span, .estados { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem 0; font-size: var(--t-0); }
  .items a { color: var(--tinta); text-decoration: none; font-weight: 600; transition: color .25s, padding .35s var(--ease); }
  .items a:hover { color: var(--rojo); padding-left: .4rem; }
  .items a :global(.icon) { width: 1rem; height: 1rem; flex: none; color: var(--rojo); }
  .sin-doc > span { color: var(--tinta-2); opacity: .8; }
  .estados { font-weight: 600; flex-wrap: wrap; }
  .anios { display: flex; flex-wrap: wrap; gap: .4rem; }
  .anios a { padding: .25rem .65rem; border-radius: 999px; border: 1px solid var(--linea); color: var(--tinta); text-decoration: none; font-variant-numeric: tabular-nums; }
  .anios a:hover { background: var(--tinta); color: #fff; border-color: var(--tinta); }
</style>

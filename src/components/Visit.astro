---
import type { Lang } from '../i18n/content';
import { content, links } from '../i18n/content';
import Icon from './Icon.astro';
import { to } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].visit;
// Un complejo P-QRS-T entre cada par de pasos
const blip = 'l 10 -4 l 6 4 l 8 0 l 5 -22 l 6 40 l 5 -18 l 12 0 l 10 -6 l 8 6';
const latido = `M0 30 H 90 ${blip} H 340 ${blip} H 590 ${blip} H 1000`;
---
<section id="pacientes" class="pasos seccion" aria-labelledby="pasos-titulo">
  <div class="contenedor">
    <header class="sec-cab">
      <h2 id="pasos-titulo" data-split>{t.title}</h2>
      <p data-reveal>{t.lead}</p>
    </header>

    <div class="linea-tiempo" data-timeline>
      <div class="pista decorativo" aria-hidden="true">
        <svg class="pista-svg" viewBox="0 0 1000 60" preserveAspectRatio="none">
          <path class="pista-base" d="M0 30 H 1000" />
          <path class="pista-latido" data-draw data-timeline-path d={latido} />
        </svg>
      </div>
      <ol class="pasos-lista">
        {t.steps.map((s, i) => (
          <li class="paso" data-step>
            <span class="paso-num" aria-hidden="true">{i + 1}</span>
            <h3><span class="visualmente-oculto">{i + 1}. </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <ul class="pasos-mas" data-reveal>
      {t.more.map((m) => (
        <li><a class="enlace-flecha" href={to(lang, m.href)}>{m.label}<Icon name="arrow" /></a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pasos { background: var(--niebla); position: relative; overflow: hidden; }
  .linea-tiempo { position: relative; }
  .pista { position: absolute; left: 0; right: 0; top: 1.1rem; height: 3.75rem; transform: translateY(-50%); }
  .pista-svg { width: 100%; height: 100%; overflow: visible; }
  .pista-base { fill: none; stroke: var(--linea); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .pista-latido { fill: none; stroke: var(--rojo); stroke-width: 2.5; stroke-linejoin: round; stroke-dasharray: var(--len, none); stroke-dashoffset: calc(var(--avance, 0) * var(--len, 0px)); }
  .pasos-lista { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; position: relative; }
  .paso { display: grid; gap: .8rem; align-content: start; }
  .paso-num {
    width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 1rem;
    background: var(--papel); color: var(--tinta); border: 2px solid var(--linea);
    box-shadow: 0 0 0 6px var(--niebla);
    transition: background-color .5s var(--ease), color .5s var(--ease), border-color .5s var(--ease), transform .6s var(--ease);
    margin-bottom: 1.2rem;
  }
  .paso.encendido .paso-num { background: var(--rojo); color: #fff; border-color: var(--rojo); transform: scale(1.12); }
  .paso h3 { font-size: var(--t-3); letter-spacing: -.015em; }
  .paso p { color: var(--tinta-2); font-size: var(--t-0); max-width: 18rem; }
  .pasos-mas { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem 2.4rem; margin-top: clamp(3rem, 5vw, 4.5rem); padding-top: 2rem; border-top: 1px solid var(--linea); }

  @media (max-width: 860px) {
    .pista { left: 1.1rem; right: auto; top: 0; bottom: 0; width: 2px; height: auto; transform: none; background: var(--linea); }
    .pista-svg { display: none; }
    .pista::after { content: ''; position: absolute; inset: 0; background: var(--rojo); transform-origin: top; transform: scaleY(var(--avance-y, 1)); }
    .pasos-lista { grid-template-columns: 1fr; gap: 2.2rem; }
    .paso { grid-template-columns: auto 1fr; column-gap: 1.1rem; }
    .paso-num { grid-row: span 2; margin-bottom: 0; }
  }
</style>
